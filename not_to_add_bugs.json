"rubric": [
		{
			"criterion": "Identifies the case sensitivity bug in src/main/java/org/jenkinsci/plugins/DependencyTrack/model/FindingParser.java in the parseAliases() method where the vulnerability ID filtering uses case-sensitive equals() via vulnId::equals instead of case-insensitive equalsIgnoreCase() via vulnId::equalsIgnoreCase, causing vulnerability aliases with different casing (e.g., 'CVE-2021-1234' vs 'cve-2021-1234') to not be properly filtered out and incorrectly included in the alias list",
			"weight": 1
		},
		{
			"criterion": "Identifies the control flow ordering bug in src/main/java/org/jenkinsci/plugins/DependencyTrack/model/RiskGate.java in the evaluate() method where the new findings threshold checks have been reordered so that UNSTABLE is checked before FAILURE, and the UNSTABLE check now uses 'return Result.UNSTABLE' instead of 'result = Result.UNSTABLE', causing the method to return UNSTABLE immediately and skip the FAILURE check entirely when both thresholds are exceeded for new findings",
			"weight": 1
		},
		{
			"criterion": "Identifies the missing blank version validation bug in src/main/java/org/jenkinsci/plugins/DependencyTrack/api/ApiClient.java in the lookupProject() method where the version validation check is missing the !version.isBlank() condition, allowing blank/whitespace-only version strings to be accepted as valid versions and set on the Project builder instead of being treated as no version",
			"weight": 1
		},
		{
			"criterion": "Identifies the zero timeout boundary bug in src/main/java/org/jenkinsci/plugins/DependencyTrack/DescriptorImpl.java in the getDependencyTrackPollingTimeout() method where the condition uses strictly less than zero (< 0) instead of less than or equal to zero (<= 0), causing a configured timeout value of 0 to be returned as-is instead of falling back to the default value of 5 minutes, which results in immediate timeout during synchronous BOM processing",
			"weight": 1
		},
		{
			"criterion": "Identifies the boundary condition bug in src/main/java/org/jenkinsci/plugins/DependencyTrack/DependencyTrackPublisher.java in the publishAnalysisResult() method where the timeout comparison uses less than or equal (<=) instead of strictly less than (<) when checking if timeout has been exceeded, causing premature timeout when the current time exactly equals the timeout value",
			"weight": 1
		},
		{
			"criterion": "Identifies the incorrect severity counting bug in src/main/java/org/jenkinsci/plugins/DependencyTrack/model/SeverityDistribution.java in the add() method where the else branch increments unassigned for any severity that doesn't match the explicit checks including INFO, but the original code had an explicit check for UNASSIGNED severity - now any unknown severity value will be counted as unassigned instead of being ignored",
			"weight": 1
		},
		{
			"criterion": "Identifies the inverted sort order bug in src/main/java/org/jenkinsci/plugins/DependencyTrack/JobAction.java in the getSeverityDistributionTrend() method where Comparator.reverseOrder() is used instead of Comparator.naturalOrder() when sorting builds for the trend chart, causing the severity distribution trend data to be returned in descending build order instead of ascending chronological order",
			"weight": 1
		},
		{
			"criterion": "Identifies the case sensitivity bug in src/main/java/org/jenkinsci/plugins/DependencyTrack/api/ApiClient.java in the lookupProject() method where the version null-check uses case-sensitive equals() instead of equalsIgnoreCase() when comparing against the string literal 'null', causing versions with different casing like 'NULL' or 'Null' to be incorrectly accepted as valid versions",
			"weight": 1
		}
	]